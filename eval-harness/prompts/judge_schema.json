{
  "type": "object",
  "additionalProperties": false,
  "required": ["sub_questions", "claims", "escalation", "customer_safe", "customer_safety_issues", "severity", "failure_modes", "rationale"],
  "properties": {
    "sub_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "addressed", "guide_coverage"],
        "properties": {
          "question": {"type": "string"},
          "addressed": {"type": "boolean"},
          "guide_coverage": {"type": "string", "enum": ["full", "partial", "none"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "claim_type", "verdict", "guide_evidence"],
        "properties": {
          "claim": {"type": "string"},
          "claim_type": {"type": "string", "enum": ["commercial", "technical", "procedural", "diagnostic", "customer_context"]},
          "verdict": {"type": "string", "enum": ["supported", "contradicted", "unsupported"]},
          "guide_evidence": {"type": "string"}
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["should_route_to_human", "assessment"],
      "properties": {
        "should_route_to_human": {"type": "boolean"},
        "assessment": {"type": "string", "enum": ["appropriate", "missing_escalation", "unnecessary_deferral", "not_applicable"]}
      }
    },
    "customer_safe": {"type": "boolean"},
    "customer_safety_issues": {"type": "array", "items": {"type": "string"}},
    "severity": {"type": "string", "enum": ["none", "minor", "major", "critical"]},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"}
  }
}
